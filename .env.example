# Copy to .env locally. Never commit the populated file.
DATABASE_URL=postgresql+psycopg://witness:CHANGE_ME@localhost:5432/witness_ai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional human privacy review gate; automatic masking always remains enabled.
PRIVACY_REVIEW_REQUIRED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Enter any backend-accessible folder path in the local Import page.
DATA_ROOT=./data
# Stable random secret for matter-scoped pseudonyms. Generate before first import.
PRIVACY_KEY=REPLACE_WITH_RANDOM_SECRET
# Poppler not needed: PDFs rendered with PyMuPDF. Install Tesseract separately.
TESSERACT_CMD=

# Automatic local indexing continues in the server; choose manual to run batches yourself.
INDEXING_MODE=automatic

# UI palette ID; choose and preview options in Settings > Appearance.
UI_PALETTE=classic

# Full corpus continues through all included passages; manual runs one batch.
ANALYSIS_MODE=full
